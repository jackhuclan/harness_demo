{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentRouting": {
    "AgentRoutes": [
      { "Pattern": "(建方|建处方|创建处方|recipe.*create|load.*foup|加载.*硅片|wafer.*load|处方建立)", "Agent": "recipe" },
      { "Pattern": "(分析.*处方|处方.*分析|recipe.*analy|优化处方|recipe.*optim)", "Agent": "recipe" },
      { "Pattern": "(统计|stats|3σ|lot.*批|异常|fail|分解|budget|归因|attribution|建议|advice|补偿|compensat|R2R|链路|chain)", "Agent": "pda" },
      { "Pattern": "(性能|tool performance|重复性|趋势|trend|光源|硬件|寿命|衰减)", "Agent": "tma" },
      { "Pattern": "(诊断|报错|error|focus|聚焦|对准|处置|复测|经验|反馈|learn)", "Agent": "tdi" }
    ],
    "ToolRoutes": {
      "recipe": [
        { "Pattern": "(建方|建处方|创建处方|recipe.*create)", "Tool": "recipe_create", "Args": "{}" },
        { "Pattern": "(load|加载|foup|slot|上片|wafer.*load)", "Tool": "wafer_load", "Args": "{\"foup\":\"Foup2\",\"slot\":5}" },
        { "Pattern": "(优化|optimize|MRO|self-calibration)", "Tool": "recipe_optimize", "Args": "{}" },
        { "Pattern": "(自定义技能|习得规则|custom.*skill|动态采样)", "Tool": "custom_skill_learn", "Args": "{}" },
        { "Pattern": "(分析.*处方|处方.*分析|recipe.*analy)", "Tool": "recipe_analyze", "Args": "{}" }
      ],
      "pda": [
        { "Pattern": "(统计|stats|3σ)", "Tool": "ovl_statistics", "Args": "{}" },
        { "Pattern": "(异常|fail|根因|为什么.*fail)", "Tool": "ovl_anomaly", "Args": "{}" },
        { "Pattern": "(分解|budget|贡献项)", "Tool": "budget_decomp", "Args": "{}" },
        { "Pattern": "(归因|attribution|边缘|field-to-field)", "Tool": "attribution", "Args": "{}" },
        { "Pattern": "(建议|改进|advice)", "Tool": "decision_advice", "Args": "{}" },
        { "Pattern": "(补偿|compensat|R2R|下发)", "Tool": "r2r_comp", "Args": "{}" },
        { "Pattern": "(链路|chain|完整|怎么样|如何)", "Tool": "ovl_chain", "Args": "{}" }
      ],
      "tma": [
        { "Pattern": "(趋势|trend|近.*周|近.*月)", "Tool": "tool_trend", "Args": "{}" },
        { "Pattern": "(光源|硬件|寿命|衰减|PM)", "Tool": "hardware_health", "Args": "{}" },
        { "Pattern": "(性能|tool performance|重复性|MAM|TIS)", "Tool": "tool_performance", "Args": "{}" }
      ],
      "tdi": [
        { "Pattern": "(确认|执行处置|复测|confirm)", "Tool": "disposition_confirm", "Args": "{}" },
        { "Pattern": "(经验|反馈|习得|learn)", "Tool": "experience_learn", "Args": "{}" },
        { "Pattern": "(诊断|报错|error|focus|聚焦|对准)", "Tool": "ovl_diagnose", "Args": "{\"error\":\"粗聚焦失败\"}" }
      ]
    }
  }
}
